// TaqwaBazaar database schema (MySQL on Hostinger)
// Money is stored as Decimal(10,2) in BDT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── Catalog ─────────────

model Category {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(120)
  nameBn    String? @db.VarChar(120)
  slug      String  @unique @db.VarChar(150)
  image     String? @db.VarChar(500)
  icon      String? @db.VarChar(50) // lucide icon name, used when no image
  parentId  Int?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(120)
  slug     String    @unique @db.VarChar(150)
  logo     String?   @db.VarChar(500)
  products Product[]
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(200)
  nameBn         String?  @db.VarChar(200)
  slug           String   @unique @db.VarChar(220)
  description    String?  @db.Text
  descriptionBn  String?  @db.Text
  categoryId     Int
  brandId        Int?
  price          Decimal  @db.Decimal(10, 2) // regular price
  salePrice      Decimal? @db.Decimal(10, 2) // discounted price
  // what the customer pays (salePrice ?? price), kept in sync on save so lists can sort/filter by it
  effectivePrice Decimal  @default(0) @db.Decimal(10, 2)
  stock          Int      @default(0) // used when product has no variants
  lowStockAt     Int      @default(5) // "running low" when stock is at or below this
  sku            String?  @unique @db.VarChar(80)
  warranty       String?  @db.VarChar(120)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  metaTitle      String?  @db.VarChar(200)
  metaDesc       String?  @db.VarChar(300)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  movements  StockMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, effectivePrice])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String  @db.VarChar(500) // Cloudinary URL
  alt       String? @db.VarChar(200)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String   @db.VarChar(120) // e.g. "52 / Black", "100ml"
  sku       String?  @unique @db.VarChar(80)
  price     Decimal? @db.Decimal(10, 2) // overrides product price if set
  stock     Int      @default(0)
  isActive  Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ───────────── Stock ─────────────

enum StockReason {
  RECEIVED // new delivery from supplier
  ADJUSTMENT // manual correction / stock count
  DAMAGED // damaged, lost or returned to supplier
  ORDER // sold
  ORDER_CANCELLED // order cancelled, items back on the shelf
  EDIT // changed from the product form
  ORDER_EDIT // order items changed in the admin panel
  ORDER_DELETED // order moved to Trash, items back on the shelf
}

model StockMovement {
  id          Int         @id @default(autoincrement())
  productId   Int
  variantId   Int?
  variantName String?     @db.VarChar(120)
  change      Int // + in, - out
  balance     Int // stock of the product/variant after this change
  reason      StockReason
  reference   String?     @db.VarChar(120) // supplier invoice, order number...
  note        String?     @db.VarChar(255)
  adminName   String?     @db.VarChar(120)
  createdAt   DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

// ───────────── Orders ─────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNo          String      @unique @db.VarChar(20)
  customerName     String      @db.VarChar(120)
  phone            String      @db.VarChar(20)
  address          String      @db.VarChar(500)
  zone             String      @db.VarChar(20) // inside / outside Dhaka
  note             String?     @db.VarChar(500)
  subtotal         Decimal     @db.Decimal(10, 2)
  shippingFee      Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  payment          String      @default("COD") @db.VarChar(20)
  status           OrderStatus @default(PENDING)
  source           String      @default("WEB") @db.VarChar(20) // WEB or PHONE (entered by staff)
  adminNote        String?     @db.VarChar(1000)
  // true while the ordered quantities are taken out of stock; cancelling puts them back
  stockDeducted    Boolean     @default(true)
  editedAt         DateTime? // last time staff edited the order (shows the "Edited" badge)
  // Trash: deleted orders keep everything until restored or permanently deleted
  deletedAt        DateTime?
  deletedBy        String?     @db.VarChar(120)
  // true when moving to Trash put the items back on the shelf, so Restore takes them out again
  trashRestocked   Boolean     @default(false)
  // Courier booking (Steadfast). consignmentId set = already sent; it can never be sent twice.
  courier          String?     @db.VarChar(20)
  consignmentId    String?     @unique @db.VarChar(40)
  trackingCode     String?     @db.VarChar(40)
  courierStatus    String?     @db.VarChar(50) // as reported by the courier, e.g. in_review, delivered
  courierCod       Decimal?    @db.Decimal(10, 2) // amount the rider collects
  courierSentAt    DateTime?
  courierSentBy    String?     @db.VarChar(120)
  courierCheckedAt DateTime?
  // set while a send is in flight, so two clicks can never book the same order twice
  courierLockAt    DateTime?
  // fraud risk of this phone number: safe | caution | risky | new | blocked (kept in sync per phone by src/lib/fraud.ts)
  riskLevel        String?     @db.VarChar(10)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items   OrderItem[]
  history OrderStatusLog[]

  @@index([phone])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([riskLevel])
}

model OrderStatusLog {
  id        Int          @id @default(autoincrement())
  orderId   Int
  status    OrderStatus?
  message   String       @db.VarChar(255)
  // edits: JSON array of "what changed" lines shown under the message
  details   String?      @db.Text
  adminName String?      @db.VarChar(120) // null = customer / system
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int?
  variantId   Int? // plain id (no FK) so stock can be returned on cancel
  name        String  @db.VarChar(200) // snapshot at order time
  variantName String? @db.VarChar(120)
  image       String? @db.VarChar(500)
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ───────────── Admin panel ─────────────

enum AdminRole {
  ADMIN
  STAFF
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  sessions AdminSession[]
}

model AdminSession {
  id        String   @id @db.VarChar(64) // sha256 of the cookie token; the raw token is never stored
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Store settings ─────────────

// Simple key/value store for admin-editable settings (see src/lib/settings.ts for the keys).
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Homepage banners (Admin → Settings → Banners). "main" = big slider, "side" = the two small ones.
model Banner {
  id        Int      @id @default(autoincrement())
  position  String   @default("main") @db.VarChar(10)
  image     String   @db.VarChar(500)
  title     String?  @db.VarChar(150)
  link      String?  @db.VarChar(300)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([position, isActive, sortOrder])
}

// ───────────── Fraud check ─────────────

// Courier-wide delivery history for a phone number (from BD Courier), cached so each number is looked up at most once a day.
model FraudCheck {
  phone     String   @id @db.VarChar(20)
  total     Int      @default(0)
  success   Int      @default(0)
  cancelled Int      @default(0)
  couriers  String   @db.Text // JSON: [{ name, total, success, cancelled }]
  reports   String   @db.Text // JSON: [{ courier, details, date }] fraud reports by other merchants
  checkedAt DateTime @default(now())
}

// Numbers staff marked as fake. Orders from them are still accepted but flagged "blocked".
model BlockedPhone {
  phone     String   @id @db.VarChar(20)
  reason    String   @db.VarChar(255)
  blockedBy String?  @db.VarChar(120)
  createdAt DateTime @default(now())
}
