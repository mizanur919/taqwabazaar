# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
# Local:     mysql://root:@localhost:3306/taqwabazaar
# Hostinger: mysql://u123456789_user:PASSWORD@localhost:3306/u123456789_taqwabazaar
#            (use the host shown in hPanel → Databases if the app is not on the same server)
# connection_limit keeps us under Hostinger's per-user connection cap.
# Hostinger MySQL closes idle connections after 20s (wait_timeout=20), so Prisma must drop them first:
# max_idle_connection_lifetime=15 (seconds). connect_timeout/socket_timeout make a stuck connection fail and be
# replaced instead of blocking the pool for good (seen as P2024 "Timed out fetching a new connection").
DATABASE_URL="mysql://root:@localhost:3306/taqwabazaar?connection_limit=5&pool_timeout=20&max_idle_connection_lifetime=15&connect_timeout=10&socket_timeout=20"

# Where uploaded images are stored and the public URL that serves that folder.
# Local: storage/uploads + /uploads   Hostinger: <img subdomain folder> + https://img.taqwabazaar.com
UPLOAD_DIR="storage/uploads"
UPLOAD_BASE_URL="/uploads"
